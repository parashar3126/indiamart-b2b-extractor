{
  "actorSpecification": 1,
  "name": "indiamart-b2b-extractor",
  "title": "IndiaMART B2B Suppliers & Lead Extractor",
  "description": "Fast asynchronous scraper to extract supplier details, products, phone numbers, and cities from IndiaMART.",
  "version": "0.0",
  "meta": {
    "templateId": "python-empty"
  },
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "IndiaMART Extracted Leads",
      "fields": {
        "type": "object",
        "properties": {
          "company_or_product": {
            "type": "string",
            "title": "Company / Product"
          },
          "phone": {
            "type": "string",
            "title": "Phone Number"
          },
          "price": {
            "type": "string",
            "title": "Price"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "indiamart_url": {
            "label": "IndiaMART URL",
            "type": "string"
          },
          "details": {
            "type": "string",
            "title": "Details"
          }
        }
      },
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "company_or_product",
              "phone",
              "price",
              "city",
              "indiamart_url",
              "details"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "company_or_product": {
                "label": "Company / Product",
                "format": "text"
              },
              "phone": {
                "label": "Phone Number",
                "format": "text"
              },
              "price": {
                "label": "Price",
                "format": "text"
              },
              "city": {
                "label": "City",
                "format": "text"
              },
              "indiamart_url": {
                "label": "URL",
                "format": "link"
              },
              "details": {
                "label": "Details",
                "format": "text"
              }
            }
          }
        }
      }
    }
  }
}